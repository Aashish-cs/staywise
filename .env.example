# StayWise environment template.
# Copy to .env.local for local development. Do not commit real secrets.

# Public browser-safe app/site values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side location lookup. StayWise currently uses OpenStreetMap/Nominatim
# through server routes, so no paid maps key is required for the current app.
NOMINATIM_EMAIL=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_BASE_URL=https://nominatim.openstreetmap.org/reverse

# Reserved for a future Mapbox provider. Leave blank unless the app is changed
# to read this variable.
MAPBOX_ACCESS_TOKEN=

# Optional server-only AI adapter. Leave blank to use the no-cost deterministic parser.
# STAYWISE_AI_* is preferred; OPENAI_* aliases are supported by the code.
STAYWISE_AI_API_KEY=
STAYWISE_AI_BASE_URL=https://api.openai.com/v1
STAYWISE_AI_MODEL=gpt-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional server-only Stripe architecture. Leave blank for MVP pay-later flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional server-only Supabase admin key. Required only for Stripe webhook
# ledger updates and other trusted admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Test runner knobs. Usually not needed for normal local development.
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=3014
